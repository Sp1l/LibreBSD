
.include <bsd.own.mk>

# OpenSSL version used for manual page generation
OPENSSL_VER=	3.9.1
OPENSSL_DATE=	2024-03-27

LIBRESSL_SRC=	${SRCTOP}/crypto/libressl
LCRYPTO_SRC=	${LIBRESSL_SRC}/crypto
LCRYPTO_DOC=	${LCRYPTO_SRC}/doc

CFLAGS+=	-DTERMIOS -DANSI_SOURCE
CFLAGS+=	-I${LIBRESSL_SRC}/include/compat
CFLAGS+=	-DLIBRESSL_INTERNAL
CFLAGS+=	-D__BEGIN_HIDDEN_DECLS= -D__END_HIDDEN_DECLS=
CFLAGS+=	-DOPENSSLDIR="\"/etc/ssl\""
CFLAGS+=	-D_FORTIFY_SOURCE=2
# HARDEN_FLAGS from port output
CFLAGS+=	-fno-strict-overflow -fstack-protector-strong -fcf-protection=full

# LibreSSL compat from ports build
# include/compat/arpa/nameser.h
CFLAGS+=	-DHAVE_ARPA_NAMESER_H=1
# include/compat/endian.h
CFLAGS+=	-DHAVE_ENDIAN_H=1
CFLAGS+=	-DHAVE_MACHINE_ENDIAN_H=1
# include/compat/err.h
CFLAGS+=	-DHAVE_ERR_H=1
# include/compat/netinet/ip.h
CFLAGS+=	-DHAVE_NETINET_IP_H=1
# include/compat/poll.h
CFLAGS+=	-DHAVE_POLL=1
# include/compat/resolv.h
CFLAGS+=	-DHAVE_RESOLV_H=1
# include/compat/readpassphrase.h
CFLAGS+=	-DHAVE_READPASSPHRASE=1
CFLAGS+=	-DHAVE_READPASSPHRASE_H=1
# include/compat/stdlib.h
CFLAGS+= \
	-DHAVE_ARC4RANDOM=1 \
	-DHAVE_ARC4RANDOM_BUF=1 \
	-DHAVE_ARC4RANDOM_UNIFORM=1 \
	-DHAVE_GETPROGNAME=1 \
	-DHAVE_STRTONUM=1
# include/compat/string.h
CFLAGS+= \
	-DHAVE_EXPLICIT_BZERO=1 \
	-DHAVE_STRCASECMP=1 \
	-DHAVE_MEMMEM=1 \
	-DHAVE_STRLCAT=1 \
	-DHAVE_STRLCPY=1 \
	-DHAVE_STRNDUP=1 \
	-DHAVE_STRNLEN=1 \
	-DHAVE_STRSEP=1 \
	-DHAVE_TIMINGSAFE_BCMP=1 \
	-DHAVE_TIMINGSAFE_MEMCMP=1
# include/compat/time.h
CFLAGS+= \
	-DHAVE_TIMEGM=1 \
	-DHAVE_CLOCK_GETTIME=1
# include/compat/unistd.h
CFLAGS+= \
	-DHAVE_UNISTD_H=1 \
	-DHAVE_PIPE2=1 \
	-DHAVE_GETOPT=1
# include/compat/stdio.h crypto/compat/bsd-asprintf.c
CFLAGS+= \
	-DHAVE___VA_COPY=1 \
	-DHAVE_VA_COPY=1 \
	-DHAVE_ASPRINTF=1
# crypto/compat/syslog_r.c
CFLAGS+=	-DHAVE_SYSLOG=1
# crypto/compat/timegm.c
CFLAGS+=	-DSIZEOF_TIME_T=8
# apps/nc/compat/sys/socket.h
CFLAGS+=	-DHAVE_ACCEPT4=1

# Generated in ports build, not referenced / unreachable
CFLAGS+= \
	-DHAVE_DL_ITERATE_PHDR=1 \
	-DHAVE_DLFCN_H=1 \
	-DHAVE_INTTYPES_H=1 \
	-DHAVE_NETDB_H=1 \
	-DHAVE_NETINET_IN_H=1 \
	-DHAVE_REALLOCARRAY=1 \
	-DHAVE_SOCKETPAIR=1 \
	-DHAVE_STDINT_H=1 \
	-DHAVE_STDIO_H=1 \
	-DHAVE_STDLIB_H=1 \
	-DHAVE_STRING_H=1 \
	-DHAVE_STRINGS_H=1 \
	-DHAVE_SYMLINK=1 \
	-DHAVE_SYS_STAT_H=1 \
	-DHAVE_SYS_TYPES_H=1 \
	-DSTDC_HEADERS=1

LDADD+=	-lthr

MANDIR=	${SHAREDIR}/openssl/man/man

.if defined(LIB)
_docs=	${LIB}
_skip=	SSLeay_version des_modes
_sec=	3
.else
_docs=	apps
_skip=	config
_sec=	1
.endif
