# $FreeBSD$

.include <bsd.own.mk>

# OpenSSL version used for manual page generation
OPENSSL_VER=	3.5.2
OPENSSL_DATE=	2022-04-23

LIBRESSL_SRC=	${SRCTOP}/crypto/libressl
LCRYPTO_SRC=	${LIBRESSL_SRC}/crypto
LCRYPTO_DOC=	${LCRYPTO_SRC}/doc

CFLAGS+=	-DTERMIOS -DANSI_SOURCE
CFLAGS+=	-I${LIBRESSL_SRC}/include
CFLAGS+=	-I${LIBRESSL_SRC}/include/compat
CFLAGS+=	-DLIBRESSL_INTERNAL
CFLAGS+=	-D__BEGIN_HIDDEN_DECLS= -D__END_HIDDEN_DECLS=
CFLAGS+=	-DOPENSSLDIR="\"/etc/ssl\""

# LibreSSL compat from ports build
# arpa/nameser.h
CFLAGS+=	-DHAVE_ARPA_NAMESER_H
# err.h
CFLAGS+=	-DHAVE_ERR_H
# netinet/ip.h
CFLAGS+=	-DHAVE_NETINET_IP_H
# poll.h
CFLAGS+=	-DHAVE_POLL
# resolv.h
CFLAGS+=	-DHAVE_RESOLV_H
# stdlib.h
CFLAGS+=	-DHAVE_STRTONUM -DHAVE_GETPROGNAME \
		-DHAVE_ARC4RANDOM -DHAVE_ARC4RANDOM_BUF -DHAVE_ARC4RANDOM_UNIFORM
# string.h
CFLAGS+=	-DHAVE_STRLCAT -DHAVE_STRLCPY -DHAVE_STRNDUP -DHAVE_STRNLEN -DHAVE_STRSEP \
		-DHAVE_MEMMEM -DHAVE_EXPLICIT_BZERO -DHAVE_TIMINGSAFE_BCMP -DTIMINGSAFE_MEMCMP
# time.h
CFLAGS+=	-DHAVE_TIMEGM -DHAVE_CLOCK_GETTIME
# unistd.h
CFLAGS+=	-DHAVE_PIPE2

LDADD+=	-lthr

MANDIR=	${SHAREDIR}/openssl/man/man

.if defined(LIB)
_docs=	${LIB}
_skip=	SSLeay_version des_modes
_sec=	3
.else
_docs=	apps
_skip=	config
_sec=	1
.endif
